# Core paths
PROJECT_ROOT=.
DNS_REPO=./submodules/DNS-Challenge
DATA_ROOT=./data
DNS_CLEAN_ROOT=./submodules/DNS-Challenge/datasets_fullband/clean_fullband
DNS_NOISE_ROOT=./submodules/DNS-Challenge/noise_fullband
DNS_RIR_ROOT=./submodules/DNS-Challenge/datasets/impulse_responses
DNS_DEV_TESTSET=./submodules/DNS-Challenge/V5_dev_testset

# PyTorch install mode
PYTORCH_FLAVOR=gpu
PYTORCH_CUDA_FLAVOR=cu124
TORCH_VERSION=2.5.1

# Audio processing defaults
SAMPLE_RATE=16000
N_FFT=512
HOP_LENGTH=128
WIN_LENGTH=512

# Training defaults
BATCH_SIZE=8
NUM_EPOCHS=20
LEARNING_RATE=0.001
SEED=42

# Experiment output
EXPERIMENTS_ROOT=./experiments
